{
  "name": "scoremore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ScoreMore — Supabase-based GSSSB CCE examination platform starter.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode scoremore",
    "build": "npm run build:scoremore",
    "build:scoremore": "vite build --mode scoremore",
    "build:ranktiger": "vite build --mode ranktiger",
    "preview": "vite preview",
    "verify:targets": "node scripts/verify-build-targets.mjs",
    "verify:branding": "node scripts/verify-brand-safety.mjs",
    "verify:patch2": "npm run verify:targets && npm run verify:branding",
    "package:ranktiger": "node scripts/package-ranktiger-release.mjs",
    "verify:release-foundation": "node scripts/verify-release-foundation.mjs",
    "verify:patch3": "npm run verify:patch2 && npm run verify:release-foundation"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  },
  "devDependencies": {
    "vite": "8.1.5"
  }
}
