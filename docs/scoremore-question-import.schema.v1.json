{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremore.local/schemas/scoremore-question-import.schema.v1.json",
  "title": "ScoreMore Question Import Package",
  "description": "Version 1.0.0 structured payload embedded in a ScoreMore HTML import package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package_id",
    "source",
    "defaults",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "scoremore.question-import"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{5,119}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "maxLength": 200
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "questionType": {
      "enum": [
        "NORMAL",
        "PYQ"
      ]
    },
    "difficulty": {
      "enum": [
        "EASY",
        "MEDIUM",
        "HARD"
      ]
    },
    "contentOrigin": {
      "enum": [
        "SOURCE_EXTRACTED",
        "OCR_EXTRACTED",
        "AI_TRANSCRIBED",
        "MANUAL_ENTRY",
        "RECONSTRUCTED",
        "AI_GENERATED"
      ]
    },
    "verificationStatus": {
      "enum": [
        "UNVERIFIED",
        "NEEDS_CHECK",
        "VERIFIED",
        "DISPUTED"
      ]
    },
    "answerSource": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "OFFICIAL_FINAL_KEY",
        "OFFICIAL_PROVISIONAL_KEY",
        "MANUALLY_VERIFIED",
        "SOURCE_BOOK",
        "ADMIN_CORRECTED",
        null
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageRef": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "original_file_name",
        "board_id",
        "exam_id"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "original_file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "board_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "exam_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "exam_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "shift_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "paper_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "source_checksum_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_type": {
          "$ref": "#/$defs/questionType"
        },
        "board_id": {
          "type": "string"
        },
        "exam_id": {
          "type": "string"
        },
        "exam_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "exam_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "shift_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "paper_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "$ref": "#/$defs/difficulty"
        },
        "content_origin": {
          "$ref": "#/$defs/contentOrigin"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "answer_source": {
          "$ref": "#/$defs/answerSource"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "proposed_question_id",
        "subject_id",
        "sort_order",
        "question_text",
        "options"
      ],
      "properties": {
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "proposed_question_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        },
        "question_type": {
          "$ref": "#/$defs/questionType"
        },
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "exam_id": {
          "type": "string",
          "minLength": 1
        },
        "exam_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "exam_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "shift_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "paper_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "original_question_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "topic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "$ref": "#/$defs/difficulty"
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_question_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_origin": {
          "$ref": "#/$defs/contentOrigin"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "question_text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "correct_answer": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A",
            "B",
            "C",
            "D",
            null
          ]
        },
        "answer_source": {
          "$ref": "#/$defs/answerSource"
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imageRef"
          }
        },
        "content_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
